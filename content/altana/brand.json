    "greenDeep": "#0A1A10",
    "red": "#E63946",
    "redDeep": "#B0202C",
    "emerald": "#4FB48A",
    "emeraldSoft": "#7BD3AC",
    "emeraldDeep": "#2E7A5A",
    "emeraldGrad": "linear-gradient(135deg, #7BD3AC 0%, #4FB48A 50%, #2E7A5A 100%)",
